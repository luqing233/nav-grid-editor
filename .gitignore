# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 构建产物
*.egg-info/
build/
dist/

# uv 本地缓存（UV_CACHE_DIR=./.uv-cache 时产生）
.uv-cache/

# IDE
.idea/

# Playwright 持久化登录配置：含 Cookie / 登录态，务必不要提交
browser_profile/

# 缩略总图缓存（由 /api/overview 按需生成，删掉会自动重建；现在是 WebP）
*.overview.png
*.overview.webp

# 数美设备ID(dId)与注册载荷缓存 / 官方 SMSdk 脚本缓存。
# 设备指纹与账号无关但属于本机标识，不进版本库（删掉会自动重新铸造）。
configs/

# 仅地图资产与拼接总图随项目发布；瓦片会话、标记和其他缓存保留在本地。
assets/*
!assets/maps/
!assets/maps/**
!assets/tiles/
assets/tiles/*
!assets/tiles/maps/
!assets/tiles/maps/**

# 缩略图是可重建缓存，即使位于 maps/ 下也不发布。
assets/tiles/maps/**/*.overview.png
assets/tiles/maps/**/*.overview.webp
